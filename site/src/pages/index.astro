---
import Base from "../layouts/Base.astro";
---
<Base>
  <div class="scanlines" aria-hidden="true"></div>

  <div class="workspace">
    <header class="site-header">
      <a class="brand" href="./" aria-label="lofi-hiphopper home">
        <span class="brand-dot" aria-hidden="true">◉</span>
        <span class="brand-name">lofi hiphopper</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="#behavior" data-section-link><span class="nav-index">01</span> behavior</a>
        <a href="#preview" data-section-link><span class="nav-index">02</span> preview</a>
        <a href="#install" data-section-link><span class="nav-index">03</span> install</a>
        <a href="#faq" data-section-link><span class="nav-index">04</span> faq</a>
        <a class="nav-github" href="https://github.com/WilsonNet/lofi-hiphopper">github ↗</a>
      </nav>
      <div class="header-actions">
        <span class="header-meta">v0.3.2 · macOS</span>
        <a class="header-install" href="#install">install <span aria-hidden="true">↵</span></a>
      </div>
    </header>

    <div class="workspace-body">
      <aside class="session-rail" aria-label="Session navigation">
        <div class="rail-head">
          <span class="rail-label">SESSION</span>
          <span class="rail-path">~/lofi-hiphopper</span>
        </div>
        <nav class="rail-nav" aria-label="Sections">
          <a class="rail-link is-active" href="#top" data-section-link><span>00</span> top</a>
          <a class="rail-link" href="#behavior" data-section-link><span>01</span> behavior</a>
          <a class="rail-link" href="#preview" data-section-link><span>02</span> preview</a>
          <a class="rail-link" href="#install" data-section-link><span>03</span> install</a>
          <a class="rail-link" href="#faq" data-section-link><span>04</span> faq</a>
        </nav>
        <div class="rail-status" aria-label="Live signal status">
          <span><i class="status-dot" aria-hidden="true"></i> SILENCE</span>
          <span>AUTO-FILL ON</span>
          <span>mpv · 55%</span>
        </div>
        <div class="rail-hints" aria-hidden="true">
          <span><kbd>j</kbd><kbd>k</kbd> select</span>
          <span><kbd>enter</kbd> play</span>
          <span><kbd>h</kbd><kbd>l</kbd> visualizer</span>
          <span><kbd>?</kbd> help</span>
        </div>
      </aside>

      <main id="main" class="session-main" tabindex="-1">
        <section id="top" class="hero" aria-labelledby="hero-title">
          <div class="hero-top">
            <div class="hero-copy">
              <div class="command-line"><span class="prompt">$</span> lofi-hiphopper <span class="cmd-comment"># fills silence, yields to audio</span></div>
              <h1 id="hero-title">Fill silence with lofi.<br><span class="accent-text">Not with noise.</span></h1>
              <p class="lede">A macOS terminal companion that plays Lofi Girl when your Mac is quiet, gets out of the way for calls and other audio, and draws six live spectrum visualizers.</p>
            </div>
            <div class="hero-actions-panel">
              <div class="command-line"><span class="prompt">$</span> install</div>
              <div class="hero-actions">
                <a class="button primary" href="#install">Install</a>
                <a class="button" href="https://github.com/WilsonNet/lofi-hiphopper/releases/latest">Download release <span aria-hidden="true">↗</span></a>
              </div>
              <div class="install-mini" role="group" aria-label="Install command">
                <code>curl -fsSL https://raw.githubusercontent.com/WilsonNet/lofi-hiphopper/main/install.sh | bash</code>
                <button class="copy-button" type="button" data-copy="curl -fsSL https://raw.githubusercontent.com/WilsonNet/lofi-hiphopper/main/install.sh | bash" aria-label="Copy install command">copy</button>
              </div>
              <p class="hero-note"><span class="prompt">#</span> free · open source · no config required · macOS 14.4+</p>
            </div>
          </div>

          <div class="hero-demo">
            <div class="terminal" id="terminal" tabindex="0" aria-label="Animated lofi-hiphopper terminal preview. Press h or l to change the visualizer.">
              <div class="terminal-bar">
                <span class="traffic" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="terminal-title">lofi-hiphopper — 120×40</span>
                <span class="terminal-badge">DEMO</span>
              </div>
              <div class="terminal-screen">
                <div class="term-head">
                  <span class="term-logo"><span class="status-dot" aria-hidden="true"></span> lofi hiphopper</span>
                  <span class="term-notice">silence → sound</span>
                  <span class="term-head-right"><span>AUTO-FILL ON</span><span class="pulse-dot" aria-hidden="true">●</span> FILLING</span>
                </div>
                <div class="term-rule" aria-hidden="true"></div>
                <div class="term-grid">
                  <div class="term-left">
                    <section class="panel radio-panel" aria-label="Radio list preview">
                      <span class="panel-title">RADIO</span>
                      <span class="panel-hint">j/k · enter</span>
                      <ul class="radio-list">
                        <li class="selected"><span class="radio-marker">▸</span><span class="radio-dot playing">●</span> lofi hip hop</li>
                        <li><span class="radio-marker"></span><span class="radio-dot">○</span> live now</li>
                        <li><span class="radio-marker"></span><span class="radio-dot">○</span> synthwave radio</li>
                        <li><span class="radio-marker"></span><span class="radio-dot">○</span> chillhop</li>
                      </ul>
                    </section>
                    <section class="panel signal-panel" aria-label="Signal status preview">
                      <span class="panel-title">SIGNAL</span>
                      <dl>
                        <dt>audio</dt><dd>silence</dd>
                        <dt>spectrum</dt><dd class="ok">live</dd>
                        <dt>player</dt><dd>mpv · 55%</dd>
                        <dt>auto-fill</dt><dd>on</dd>
                      </dl>
                    </section>
                  </div>

                  <section class="panel viz-panel" aria-label="Spectrum visualizer preview">
                    <span class="panel-title">VISUALIZER</span>
                    <span class="viz-meta"><span id="peak-label">peak 98 Hz</span> <span id="mode-label">BARS · 1/6</span> <span class="nowrap">h/l</span></span>
                    <div class="viz-wrap">
                      <canvas id="visualizer" width="720" height="330" aria-hidden="true"></canvas>
                      <div class="viz-axis" aria-hidden="true"><span>63</span><span>125</span><span>250</span><span>500</span><span>1k</span><span>2k</span><span>4k</span><span>8k</span><span>16k</span></div>
                    </div>
                  </section>
                </div>

                <div class="term-now">
                  <span class="now-label">NOW PLAYING</span>
                  <strong>Lofi Girl · lofi hip hop radio</strong>
                  <span class="now-sub">lofi hip hop radio 📚 beats to relax/study to</span>
                  <span class="now-status"><span class="live-dot" aria-hidden="true"></span> LIVE <span class="now-volume">vol 55%</span></span>
                </div>

                <div class="term-status">
                  <span><span class="status-dot" aria-hidden="true"></span> SILENCE · filling with lofi</span>
                  <span>AUTO-FILL ON</span>
                </div>
                <div class="term-keys" aria-hidden="true">
                  <span><kbd>m</kbd> mute</span><span><kbd>-</kbd>/<kbd>=</kbd> volume</span><span><kbd>j</kbd>/<kbd>k</kbd> select</span><span><kbd>enter</kbd> play</span><span><kbd>h</kbd>/<kbd>l</kbd> visualizer</span><span><kbd>?</kbd> help</span><span><kbd>q</kbd> quit</span>
                </div>
              </div>
            </div>
            <p class="demo-caption">Click the terminal, then try <kbd>h</kbd> / <kbd>l</kbd> to switch visualizers. <span class="dim">Decorative live preview.</span></p>
          </div>
        </section>

        <section id="behavior" class="section" aria-labelledby="features-title">
          <header class="section-head">
            <div class="command-line"><span class="prompt">$</span> lofi-hiphopper --behavior</div>
            <h2 id="features-title">Plays when quiet. Yields when it matters.</h2>
            <p>No mixing, no talking over your meeting. lofi-hiphopper watches macOS audio activity and fills only the silence.</p>
          </header>
          <div class="feature-table">
            <article class="feature-row">
              <span class="feature-key">fill</span>
              <h3>Fills silence automatically</h3>
              <p>When no app is producing audio, it starts the selected radio. When sound returns, it stops or mutes based on your hold mode.</p>
            </article>
            <article class="feature-row">
              <span class="feature-key">call</span>
              <h3>Call-aware</h3>
              <p>Any app that opens the microphone counts as a call. Zoom, Meet, FaceTime, Teams: playback holds immediately.</p>
            </article>
            <article class="feature-row">
              <span class="feature-key">viz</span>
              <h3>Six live visualizers</h3>
              <p>Bars, mirror, scope, halo, aurora, and matrix. Real FFT data, smooth attack and release, falling peak caps, and a frequency ruler.</p>
            </article>
            <article class="feature-row">
              <span class="feature-key">keys</span>
              <h3>Editable everything</h3>
              <p>Keyboard bindings and mouse gestures live in one YAML table. Wheel volume, shift-wheel radio, ctrl-wheel visualizer.</p>
            </article>
            <article class="feature-row">
              <span class="feature-key">bypass</span>
              <h3>Bypass noisy tools</h3>
              <p>Simulators and helper apps can keep an audio stream open. Add them to <code>bypass_apps</code> so they never interrupt lofi.</p>
            </article>
            <article class="feature-row">
              <span class="feature-key">update</span>
              <h3>Updates by release</h3>
              <p>Release builds check GitHub on launch. A newer version appears as <kbd>u</kbd> in the footer; install and restart from the TUI.</p>
            </article>
          </div>
        </section>

        <section id="preview" class="section" aria-labelledby="preview-title">
          <header class="section-head">
            <div class="command-line"><span class="prompt">$</span> open preview</div>
            <h2 id="preview-title">A terminal that feels alive.</h2>
            <p>Truecolor panels, gradient spectrum bars, braille line work, and a compact layout that still fits a small window.</p>
          </header>
          <div class="screens">
            <figure class="screen-card screen-wide">
              <img src="assets/visualizers.png" alt="Six lofi-hiphopper visualizers: bars, mirror, scope, halo, aurora, and matrix." loading="lazy" width="1800" height="865">
              <figcaption><span class="prompt" aria-hidden="true">#</span> Six visualizers, one radio list, real spectrum data.</figcaption>
            </figure>
            <figure class="screen-card">
              <img src="assets/shortcuts.png" alt="The lofi-hiphopper shortcut sheet open over the terminal." loading="lazy" width="1800" height="1293">
              <figcaption><span class="prompt" aria-hidden="true">#</span> Press <kbd>?</kbd> for the live shortcut sheet. Every binding is editable.</figcaption>
            </figure>
          </div>
        </section>

        <section id="install" class="section" aria-labelledby="install-title">
          <header class="section-head">
            <div class="command-line"><span class="prompt">$</span> curl -fsSL .../install.sh | bash</div>
            <h2 id="install-title">One command, then it listens.</h2>
            <p>macOS 14.4 or newer. Install the runtime dependencies with Homebrew, then run the installer. It downloads the latest release, verifies its checksum, and puts the binary in <code>~/.local/bin</code>.</p>
          </header>
          <div class="install-grid">
            <div class="install-block">
              <div class="code-shell">
                <pre class="code-block" aria-label="Install commands"><code><span class="code-comment"># runtime dependencies</span>
brew install mpv yt-dlp ffmpeg

<span class="code-comment"># latest release</span>
curl -fsSL https://raw.githubusercontent.com/WilsonNet/lofi-hiphopper/main/install.sh | bash

<span class="code-comment"># start filling silence</span>
lofi-hiphopper</code></pre>
                <button class="copy-button" type="button" data-copy="brew install mpv yt-dlp ffmpeg
curl -fsSL https://raw.githubusercontent.com/WilsonNet/lofi-hiphopper/main/install.sh | bash
lofi-hiphopper" aria-label="Copy install commands">copy</button>
              </div>
              <p class="small-note">No config file is created. Defaults live inside the binary. To customize, run <code>lofi-hiphopper -print-config</code> and redirect it wherever you like.</p>
            </div>
            <div class="install-block">
              <div class="command-line"><span class="prompt">$</span> lofi-hiphopper -print-config</div>
              <pre class="code-block config-block" aria-label="Optional configuration example"><code><span class="code-comment"># optional overrides; everything else stays default</span>
volume: 35
hold_mode: stop      <span class="code-comment"># stop | pause | mute</span>

bypass_apps:
  - "CoreSimulator"
  - "com.example.MyApp"

shortcuts:
  - action: mute
    keys: ["m"]
  - action: next_radio
    keys: ["j", "shift+wheel_down"]</code></pre>
              <p class="small-note">Read the <a href="https://github.com/WilsonNet/lofi-hiphopper/blob/main/docs/configuration.md">configuration reference ↗</a> or build <a href="https://github.com/WilsonNet/lofi-hiphopper">from source ↗</a>.</p>
            </div>
          </div>
        </section>

        <section id="faq" class="section" aria-labelledby="faq-title">
          <header class="section-head">
            <div class="command-line"><span class="prompt">$</span> lofi-hiphopper --help</div>
            <h2 id="faq-title">Good questions.</h2>
          </header>
          <div class="faq-list">
            <details>
              <summary>Does it work on Linux?</summary>
              <p>Not yet. This release is macOS-only because detection uses the CoreAudio per-process API. Linux support is planned for a future release.</p>
            </details>
            <details>
              <summary>Does it record my microphone?</summary>
              <p>No. It reads CoreAudio process flags to see whether an app has an active input or output stream. The only audio it decodes is the radio stream, silently, to draw the spectrum.</p>
            </details>
            <details>
              <summary>What happens during a Zoom or Meet call?</summary>
              <p>Any app with an active microphone stream holds playback immediately. With the default <code>hold_mode: stop</code>, the stream stops and re-resolves when the call ends. <code>pause</code> and <code>mute</code> are opt-in alternatives.</p>
            </details>
            <details>
              <summary>Why does it say “waiting for silence”?</summary>
              <p>Another app is producing audio. Check the footer for the app name. If the audio is not important, add the app to <code>bypass_apps</code> in your optional config.</p>
            </details>
            <details>
              <summary>Why does it need mpv, yt-dlp, and ffmpeg?</summary>
              <p>mpv handles playback, yt-dlp resolves YouTube and channel live URLs, and ffmpeg produces the silent audio analysis for the visualizers. Playback continues if the analyser fails.</p>
            </details>
            <details>
              <summary>Is it free?</summary>
              <p>Yes. The code, releases, installer, and visualizers are free and open source. There is no account, telemetry, or paywall.</p>
            </details>
          </div>
        </section>

        <section class="final-cta" aria-labelledby="cta-title">
          <div class="final-copy">
            <div class="command-line"><span class="prompt">$</span> install lofi-hiphopper</div>
            <h2 id="cta-title">Let the quiet sound better.</h2>
            <p>Install the latest release, or star the repository and build from source.</p>
          </div>
          <div class="cta-actions">
            <a class="button primary" href="https://github.com/WilsonNet/lofi-hiphopper/releases/latest">Download latest <span aria-hidden="true">↗</span></a>
            <a class="button" href="https://github.com/WilsonNet/lofi-hiphopper">View on GitHub</a>
          </div>
        </section>
      </main>
    </div>

    <footer class="site-footer">
      <div class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span>lofi-hiphopper · v0.3.2 · macOS</span>
        <span class="footer-sep" aria-hidden="true">/</span>
        <span>built with <a href="https://charm.sh">Charm</a> Bubble Tea</span>
      </div>
      <div class="footer-links">
        <a href="https://github.com/WilsonNet/lofi-hiphopper">GitHub</a>
        <a href="https://github.com/WilsonNet/lofi-hiphopper/releases">Releases</a>
        <a href="https://github.com/WilsonNet/lofi-hiphopper/blob/main/README.md">README</a>
        <span>© <span id="year">2026</span></span>
      </div>
    </footer>
  </div>

  <div class="copy-toast" id="copy-toast" role="status" aria-live="polite"></div>

  <dialog class="shortcut-dialog" id="shortcut-dialog" aria-labelledby="shortcut-title">
    <div class="dialog-head">
      <h2 id="shortcut-title">SHORTCUTS</h2>
      <button class="dialog-close" type="button" aria-label="Close shortcuts">×</button>
    </div>
    <dl>
      <dt>j / k</dt><dd>select radio</dd>
      <dt>enter</dt><dd>play selection</dd>
      <dt>h / l</dt><dd>visualizer</dd>
      <dt>m</dt><dd>mute</dd>
      <dt>- / =</dt><dd>volume</dd>
      <dt>a</dt><dd>auto-fill</dd>
      <dt>?</dt><dd>shortcuts</dd>
      <dt>q</dt><dd>quit</dd>
    </dl>
    <p class="dialog-note">Mouse wheel: volume · shift+wheel: radio · ctrl+wheel: visualizer</p>
  </dialog>

  <script>
    import "../scripts/app.js";
  </script>
</Base>
